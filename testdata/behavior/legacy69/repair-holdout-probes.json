    "sql": "INSERT INTO \"TypeSmoke\"(s_min,dt2_p0,bin_fixed) VALUES ('X','2025-01-01',decode(repeat('00',16),'hex')); UPDATE \"TypeSmoke\" SET bin_fixed=decode('ab','hex') RETURNING encode(bin_fixed,'hex');",
